{
  "name": "cs-degree-lab-desktop",
  "productName": "CS Degree Lab",
  "version": "0.1.0",
  "description": "A university-level computer science curriculum you can run on your computer.",
  "author": "Jaden West",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.csdegreelab",
    "productName": "CS Degree Lab",
    "files": ["main.js", "web/**/*", "!web/sw.js", "!web/artifact.html", "!web/pyodide/python_stdlib.zip"],
    "directories": { "output": "release" },
    "icon": "../public/icons/icon-512.png",
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": true, "artifactName": "CS-Degree-Lab-Setup.${ext}" },
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "category": "public.app-category.education", "identity": null },
    "dmg": { "artifactName": "CS-Degree-Lab-Mac.${ext}" }
  }
}
